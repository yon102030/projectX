<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/back8" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="לוח נתונים מנהל"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#005EB4"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/statsBox"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp"
        android:background="#CCFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/tvTotalUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="טוען משתמשים..."
            android:textSize="18sp"
            android:textColor="#333"/>

        <TextView
            android:id="@+id/tvTotalClothes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="טוען פריטים..."
            android:textSize="18sp"
            android:textColor="#333"/>

        <TextView
            android:id="@+id/tvSeasonStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="פילוח עונות..."
            android:textSize="16sp"
            android:textColor="#005EB4"
            android:layout_marginTop="5dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvColorsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="צבעים הכי פופולריים:"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#005EB4"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/statsBox"
        app:layout_constraintStart_toStartOf="@id/statsBox" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminTopColors"
        android:layout_width="350dp"
        android:layout_height="250dp"
        android:layout_marginTop="10dp"
        android:background="#CCFFFFFF"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvColorsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/btn_circle_dark"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_media_previous"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>