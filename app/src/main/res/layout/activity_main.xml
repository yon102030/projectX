<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DCEBFA"
    tools:context=".MainActivity">

    <!-- רקע תמונה עדין -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/back9"
        android:alpha="0.2"
        android:translationY="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- כותרת -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="יצירת לוק יומי לפי מזג האוויר"
        android:textColor="#1E3A8A"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#FFFFFF"
        android:padding="14dp"
        android:layout_marginTop="60dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- כפתור הרשמה -->
    <Button
        android:id="@+id/newacc"
        android:layout_width="361dp"
        android:layout_height="57dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="#4A90E2"
        android:text="הרשמה"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText" />

    <!-- כפתור התחברות -->

    <!-- כפתור אודות -->

    <!-- לוגו -->

    <Button
        android:id="@+id/signup"
        android:layout_width="365dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#3B82F6"
        android:text="התחברות"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.652"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/newacc" />

    <Button
        android:id="@+id/odot"
        android:layout_width="367dp"
        android:layout_height="55dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#60A5FA"
        android:text="אודות"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/signup" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="130dp"
        android:layout_height="128dp"
        android:layout_marginTop="52dp"
        android:scaleType="centerCrop"
        android:src="@drawable/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/odot" />

</androidx.constraintlayout.widget.ConstraintLayout>