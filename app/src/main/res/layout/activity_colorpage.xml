<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- רקע -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/back9"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <!-- TOP BAR -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="start"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_circle_dark"
                    android:src="@android:drawable/ic_media_previous"
                    android:scaleType="centerInside"
                    app:tint="#FFFFFF"/>
            </LinearLayout>

            <!-- TITLE -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="בחר צבעים ללוק שלך"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#0D47A1"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"/>

            <!-- עליונים -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="צבעים לעליונים"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#1565C0"
                android:layout_marginTop="8dp"/>

            <GridLayout
                android:id="@+id/layoutTopColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_marginTop="4dp"/>

            <Button
                android:id="@+id/btnSelectAllTopColors"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="בחר הכל (עליונים)"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#1565C0"
                android:layout_marginTop="6dp"/>

            <!-- TOP 5 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="צבעים מובילים"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0D47A1"
                android:layout_marginTop="6dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTopColors"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:nestedScrollingEnabled="false"/>

            <!-- תחתונים -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="צבעים לתחתונים"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#1565C0"
                android:layout_marginTop="10dp"/>

            <GridLayout
                android:id="@+id/layoutBottomColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_marginTop="4dp"/>

            <Button
                android:id="@+id/btnSelectAllBColors"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="בחר הכל (תחתונים)"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#1565C0"
                android:layout_marginTop="6dp"/>

            <!-- כפתור סופי -->
            <Button
                android:id="@+id/btnApply"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="הצג לוק"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#0D47A1"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>