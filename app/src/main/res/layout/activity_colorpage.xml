<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- רקע -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/back9"/>

    <!-- 🔥 כל התוכן בגלילה -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- כותרת -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="בחר צבעים ללוק שלך"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#0D47A1"
                android:gravity="center"
                android:layout_marginTop="16dp"/>

            <!-- ================= עליונים ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="צבעים לעליונים"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1565C0"
                android:layout_marginTop="16dp"/>

            <GridLayout
                android:id="@+id/layoutTopColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_marginTop="8dp"/>

            <Button
                android:id="@+id/btnSelectAllTopColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="בחר הכל (עליונים)"
                android:textColor="@android:color/white"
                android:backgroundTint="#1565C0"
                android:layout_marginTop="10dp"/>

            <!-- TOP 5 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="צבעים מובילים"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#0D47A1"
                android:layout_marginTop="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTopColors"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:nestedScrollingEnabled="false"/>

            <!-- ================= תחתונים ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="צבעים לתחתונים"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1565C0"
                android:layout_marginTop="16dp"/>

            <GridLayout
                android:id="@+id/layoutBottomColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_marginTop="5dp"/>

            <Button
                android:id="@+id/btnSelectAllBColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="בחר הכל (תחתונים)"
                android:textColor="@android:color/white"
                android:backgroundTint="#1565C0"
                android:layout_marginTop="3dp"/>

            <!-- כפתור סופי -->
            <Button
                android:id="@+id/btnApply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#0D47A1"
                android:text="הצג לוק"
                android:textColor="@android:color/white" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>